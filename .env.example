# LEX — шаблон файла окружения (.env.example)
#
# Как использовать: скопировать в .env и вписать свои значения:
#     cp .env.example .env
# Сам .env в git не попадает (.gitignore, строка 24) — в репозитории лежит только этот
# шаблон. Значения ниже — заглушки и дефолты кода, реальных ключей здесь нет.
# Файл читает src/api/config.py (load_dotenv) при старте HTTP-слоя.
#
# Пути ниже АБСОЛЮТНЫЕ, от корня репозитория — как их считает код (ROOT в config.py).
# Относительный путь разрешается от текущего каталога, а юнит на стенде стартует
# из /opt/lex-kuznitsa, поэтому относительные пути тихо уезжают.
# На стенде заказчика корень другой (/opt/lex-kuznitsa, см. deploy/lex-stand.service):
# там префикс D:/projects/lex-kuznitsa меняется на /opt/lex-kuznitsa.

# --- МОДЕЛЬ: LLM через шлюз NexusLink ---

# Адрес шлюза NexusLink (OpenAI-совместимый /v1).
NEXUS_LINK_BASE_URL=https://2.27.5.234.nip.io:4435/v1
# Модель, которую зовём через шлюз.
NEXUS_LINK_MODEL=claude-sonnet-5
# Ключ доступа к шлюзу — вставить свой (здесь заглушка).
NEXUSLINK_KEY=заполнить-ключом-nexuslink

# Включает запись обмена с моделью в файл (по умолчанию выключено: в журнал
# попадает текст вопросов сотрудников, на стенде он лишний).
# LEX_LLM_DEBUG=1
# Куда писать отладочный лог LLM.
# LEX_LLM_DEBUG_PATH=D:/projects/lex-kuznitsa/var/llm-debug.jsonl
# Полностью отключить LLM (1/true/yes/on) — режим без модели.
# LEX_NO_LLM=0
# Потолок токенов при пустом ответе (ретрай с увеличенным бюджетом).
# LEX_LLM_MAX_TOKENS=8192
# Базовый бюджет токенов на запрос.
# LEX_LLM_BASE_TOKENS=4096
# Сколько раз повторять запрос при пустом ответе.
# LEX_LLM_EMPTY_RETRIES=2
# Пауза между повторами при 429, секунды.
# LEX_LLM_RATE_PAUSE=3.0
# Сколько раз повторять запрос при 429.
# LEX_LLM_RATE_RETRIES=3
# Бюджеты токенов для ретраев, через запятую.
# LEX_LLM_RETRY_BUDGETS=4096,8192

# --- ЭМБЕДДИНГИ И РЕРАНК ---

# Адрес сервиса эмбеддингов — корень, без пути: /v1/embeddings дописывает клиент.
LEX_EMBED_URL=http://127.0.0.1:8081
# Модель эмбеддингов.
LEX_EMBED_MODEL=bge-m3
# Размерность вектора (должна совпадать с моделью).
LEX_EMBED_DIM=1024
# Адрес сервиса реранка — корень, без пути: /rerank дописывает клиент.
LEX_RERANK_URL=http://127.0.0.1:8082
# Модель реранка.
LEX_RERANK_MODEL=bge-reranker-base
# Таймаут проб сервисов, секунды (самопроверка окружения).
# LEX_PROBE_TIMEOUT=4

# --- КОРПУС И ПОИСК ---

# Каталог корпуса документов. Для стенда заказчика нужен corpus-real (реальные
# регламенты); sample-corpus — синтетический корпус для тестов и разработки.
LEX_CORPUS_DIR=D:/projects/lex-kuznitsa/corpus-real
# Сколько документов попадает в ответ.
# LEX_TOP_K=6
# Сколько кандидатов смотрим при поиске.
# LEX_CANDIDATES=24
# Порог подтверждённости ответа (доля текста, покрытая цитатами).
# LEX_GROUNDING_THRESHOLD=0.45
# Порог покрытия, ниже которого ответ идёт с оговоркой.
# CAVEAT_MIN_COVERAGE=0.72
# Минимум источников, чтобы ответ был без оговорки.
# CAVEAT_MIN_SOURCES=2
# За сколько дней до смены редакции правила ставит оговорку.
# CAVEAT_EDITION_NEAR_DAYS=30

# --- POLICY: определение направления вопроса ---

# Порог близости вопроса к направлению.
# POLICY_MIN_SCORE=0.15
# Минимум документов, чтобы направление считалось покрытым.
# POLICY_MIN_LINES=1
# Порог покрытия темы в корпусе.
# POLICY_MIN_COVERAGE=0.08

# --- ХРАНИЛИЩЕ: журналы, заявки, кейсы ---

# Корневая папка для служебных файлов.
# LEX_VAR_DIR=D:/projects/lex-kuznitsa/var
# Журнал запросов и ответов.
# LEX_JOURNAL_PATH=D:/projects/lex-kuznitsa/var/journal.jsonl
# Тикеты.
# LEX_TICKETS_PATH=D:/projects/lex-kuznitsa/var/tickets.jsonl
# Сессии диалога уточнений.
# LEX_SESSIONS_PATH=D:/projects/lex-kuznitsa/var/sessions.jsonl
# Запросы на изменение.
# LEX_CHANGE_REQUESTS_PATH=D:/projects/lex-kuznitsa/var/change_requests.jsonl
# Эскалации (заявки человеку).
# LEX_ESCALATIONS_PATH=D:/projects/lex-kuznitsa/var/escalations.jsonl
# Практические кейсы.
# LEX_CASES_PATH=D:/projects/lex-kuznitsa/var/cases.jsonl
# Манифест корпуса — того же, что открыт в LEX_CORPUS_DIR.
# LEX_MANIFEST_PATH=D:/projects/lex-kuznitsa/corpus-real/manifest.json

# --- SLA ---

# Часов на реакцию, обычный тикет (HTTP-слой).
# LEX_SLA_HOURS=48
# Часов на реакцию, приоритетный тикет (HTTP-слой).
# LEX_SLA_HOURS_HIGH=8
# Часов на реакцию, обычный тикет (модуль tickets).
# TICKET_SLA_HOURS=48
# Часов на реакцию, приоритетный тикет (модуль tickets).
# TICKET_SLA_HOURS_HIGH=8

# --- ПОЧТА ---

# Режим отправки писем: simulated — реального SMTP на стенде нет.
# EMAIL_MODE=simulated
# Адрес служебных писем о качестве.
# QUALITY_EMAIL=quality@example.invalid
# Домен корпоративной почты сотрудников.
# EMPLOYEE_EMAIL_DOMAIN=example.invalid

# --- OCR: сканы и распознавание ---

# Каталог данных Tesseract.
# TESSDATA_PREFIX=D:\models\tessdata
# Ниже этой уверенности цитата помечается «распознано неуверенно».
# LEX_OCR_LOW_CONFIDENCE=0.6

# --- UI ---

# Каталог собранной статики веб-интерфейса.
# LEX_STATIC_DIR=D:/projects/lex-kuznitsa/src/api/static

# --- МЕТРИКИ СИНТЕТИКИ ---

# Порог похожести вопросов для метрики синтетики.
# LEX_SIM_THRESHOLD=0.82
# Минимум похожих вопросов для метрики.
# LEX_SIM_MIN_COUNT=3
# Минимум кейсов, чтобы запрос на изменение признали повторяющимся.
# LEX_CR_MIN_CASES=3
# Запасное имя без префикса LEX_ — на случай старых .env (читается как fallback).
# CR_MIN_CASES=3
# Доля отказов, выше которой вопрос считается «горячим».
# LEX_HOT_REFUSAL_RATE=0.3
