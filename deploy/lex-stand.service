[Unit]
Description=LEX stand — HTTP-слой агента поиска ответов по регламентам
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lex-kuznitsa
EnvironmentFile=/opt/lex-kuznitsa/.env
Environment=PYTHONUNBUFFERED=1
# Embedding and reranking endpoints are external to this process and already
# running on sage-pl. Values are service roots; app code adds route paths.
Environment=LEX_EMBED_URL=http://127.0.0.1:8081
Environment=LEX_RERANK_URL=http://127.0.0.1:8082
ExecStart=/opt/lex-kuznitsa/.venv/bin/python -m uvicorn api.app:app --host 127.0.0.1 --port 8090 --app-dir /opt/lex-kuznitsa/src
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
